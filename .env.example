# Salin file ini menjadi .env lalu sesuaikan nilainya.
#   PowerShell: Copy-Item .env.example .env
#   Git Bash  : cp .env.example .env
# File .env tidak di-commit. Variabel lingkungan nyata (CI/PaaS) menang atas file ini.

# ------------------------------------------------------------------
# Inti
# ------------------------------------------------------------------
# Port HTTP server (1-65535).
PORT=3000
# Alamat bind. 0.0.0.0 = bisa diakses dari komputer lain di jaringan.
HOST=0.0.0.0
# WAJIB. Ganti dengan password yang kuat; dipakai untuk login panel admin.
EDULADDER_ADMIN_PASSWORD=ganti-password-ini
# Lokasi file SQLite. Kosongkan untuk memakai server/data/eduladder.db.
# EDULADDER_DB=

# ------------------------------------------------------------------
# Jaringan
# ------------------------------------------------------------------
# Origin yang boleh mengakses REST/Socket.IO.
#   *              = semua origin (default, cocok untuk LAN)
#   URL lengkap    = daftar dipisah koma, mis. https://a.example,https://b.example
EDULADDER_CORS_ORIGIN=*
# URL publik untuk QR & link join, mis. http://192.168.1.10:3000
# Kosongkan untuk memakai alamat yang dibuka di browser.
# EDULADDER_PUBLIC_URL=

# ------------------------------------------------------------------
# Keamanan
# ------------------------------------------------------------------
# Masa berlaku sesi login admin (jam, > 0, maks 168).
EDULADDER_SESSION_HOURS=12
# Maksimal percobaan login gagal per IP dalam satu jendela waktu.
EDULADDER_LOGIN_MAX_ATTEMPTS=5
# Panjang jendela rate limit login (detik).
EDULADDER_LOGIN_WINDOW_SECONDS=60

# ------------------------------------------------------------------
# Batas ukuran upload (angka + kb/mb)
# ------------------------------------------------------------------
# Body JSON (simpan bank soal dari panel admin).
EDULADDER_JSON_LIMIT=2mb
# File CSV bank soal.
EDULADDER_CSV_LIMIT=1mb
